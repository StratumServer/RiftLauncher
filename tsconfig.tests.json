{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.node.json",
  "include": ["tests/**/*", "src/global.d.ts", "src/preload/preload.d.ts"],
  "exclude": ["tests/e2e/**"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@domain/*": ["src/domain/*"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
