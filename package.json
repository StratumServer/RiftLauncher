{
  "name": "vs-launcher",
  "version": "1.6.1",
  "description": "Rift Launcher for Vintage Story",
  "overrides": {
    "js-yaml": "4.3.1",
    "tar": "7.5.22"
  },
  "main": "./out/main/index.js",
  "author": "Zaldaryon",
  "homepage": "https://github.com/StratumServer/RiftLauncher",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:ci": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --omit=dev",
    "benchmark:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/measure-windows-runtime.ps1",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "7zip-bin": "^5.2.0",
    "electron-log": "^5.2.3",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.2.0",
    "json5": "^2.2.3",
    "node-7z": "^3.0.0",
    "tar": "7.5.22",
    "uuid": "^11.1.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@headlessui/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.14.8",
    "@types/node-7z": "^2.1.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.5.8",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "i18next": "^24.0.5",
    "jsdom": "^27.4.0",
    "motion": "^11.13.1",
    "postcss": "^8.5.26",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.4",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.18.2",
    "semver": "^7.7.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
