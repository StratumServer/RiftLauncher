<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RiftLauncher.ViewModels.Pages"
             x:Class="RiftLauncher.Views.Pages.ModsListView"
             x:DataType="vm:ModsListViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Sticky Menu -->
        <Border Grid.Row="0" Background="#3309090b" Padding="8"
                BorderBrush="#0Da1a1aa" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                              Foreground="#a1a1aa" Width="16" Height="16"/>
                </Button>
                <!-- Reload -->
                <Button Grid.Column="1" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand" Margin="4,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding SearchModsCommand}">
                    <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Foreground="#a1a1aa" Width="14" Height="14"/>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="/" Foreground="#71717a" FontSize="12"/>
                    <TextBlock Text="Mods" Foreground="#e4e4e7" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <Button Grid.Column="3" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                              Foreground="#a1a1aa" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="1" Padding="8,8,8,4">
            <WrapPanel HorizontalAlignment="Center">
                <!-- Search -->
                <TextBox Text="{Binding TextFilter}" Width="200"
                         PlaceholderText="Search mods..."
                         Height="32" Margin="0,0,8,4" FontSize="12"/>
                <!-- Favorites toggle -->
                <ToggleButton IsChecked="{Binding OnlyFavorites}" Height="32"
                              Margin="0,0,8,4" Padding="6,0" Cursor="Hand"
                              ToolTip.Tip="Favorites only">
                    <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                              Foreground="#eab308" Width="14" Height="14"/>
                </ToggleButton>
                <!-- Clear -->
                <Button Height="32" Margin="0,0,8,4" Padding="8,0" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding ClearFiltersCommand}"
                        ToolTip.Tip="Clear filters">
                    <PathIcon Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"
                              Foreground="#a1a1aa" Width="14" Height="14"/>
                </Button>
                <!-- Side filter -->
                <ComboBox SelectedIndex="0" Height="32" Width="100" Margin="0,0,8,4" FontSize="11">
                    <ComboBoxItem Content="Any side"/>
                    <ComboBoxItem Content="Client"/>
                    <ComboBoxItem Content="Server"/>
                    <ComboBoxItem Content="Both"/>
                </ComboBox>
                <!-- Order filter -->
                <ComboBox SelectedIndex="0" Height="32" Width="120" Margin="0,0,8,4" FontSize="11">
                    <ComboBoxItem Content="Follows"/>
                    <ComboBoxItem Content="Downloads"/>
                    <ComboBoxItem Content="Comments"/>
                    <ComboBoxItem Content="Last Updated"/>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- Results -->
        <ScrollViewer Grid.Row="2" Padding="8">
            <Panel>
                <!-- Loading -->
                <TextBlock Text="Searching..." IsVisible="{Binding IsSearching}"
                           Foreground="#a1a1aa" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Mod cards grid -->
                <WrapPanel HorizontalAlignment="Center"
                           IsVisible="{Binding !IsSearching}">
                    <ItemsControl ItemsSource="{Binding FilteredMods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="4" Width="220" Margin="4" Padding="12"
                                        Cursor="Hand">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                   Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#a1a1aa"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" Height="28"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                                          Foreground="#71717a" Width="10" Height="10"/>
                                                <TextBlock Text="{Binding Downloads}" FontSize="10" Foreground="#71717a"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                                                          Foreground="#71717a" Width="10" Height="10"/>
                                                <TextBlock Text="{Binding Follows}" FontSize="10" Foreground="#71717a"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Author}" FontSize="10" Foreground="#71717a"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
