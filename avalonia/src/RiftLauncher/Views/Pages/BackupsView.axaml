<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RiftLauncher.ViewModels.Pages"
             x:Class="RiftLauncher.Views.Pages.BackupsView"
             x:DataType="vm:BackupsViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="24,16,24,8" Spacing="4">
      <TextBlock Text="Manage Backups"
                 FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource Zinc100Brush}"/>
      <TextBlock Text="{Binding InstallationName}"
                 FontSize="13"
                 Foreground="{DynamicResource Zinc400Brush}"/>
    </StackPanel>

    <!-- Backup list -->
    <Panel Grid.Row="1" Margin="24,0">
      <!-- Empty state -->
      <TextBlock Text="No backups found"
                 IsVisible="{Binding !Backups.Count}"
                 FontSize="16"
                 Foreground="{DynamicResource Zinc400Brush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

      <!-- List -->
      <ScrollViewer IsVisible="{Binding Backups.Count}">
        <ItemsControl ItemsSource="{Binding Backups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:BackupItemViewModel">
              <Border Margin="0,0,0,4"
                      Padding="12,6"
                      Background="{DynamicResource Zinc800Brush}"
                      CornerRadius="4"
                      Height="40">
                <Grid ColumnDefinitions="*,Auto">
                  <!-- Date -->
                  <TextBlock Text="{Binding DateDisplay}"
                             FontWeight="SemiBold" FontSize="13"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Zinc200Brush}"/>

                  <!-- Actions -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Padding="6" Background="Transparent"
                            ToolTip.Tip="Restore"
                            Command="{Binding $parent[ItemsControl].((vm:BackupsViewModel)DataContext).RequestRestoreCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z"
                                Width="14" Height="14"
                                Foreground="{DynamicResource Zinc300Brush}"/>
                    </Button>
                    <Button Padding="6" Background="Transparent"
                            ToolTip.Tip="Delete"
                            Command="{Binding $parent[ItemsControl].((vm:BackupsViewModel)DataContext).RequestDeleteCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                Width="14" Height="14"
                                Foreground="#dc2626"/>
                    </Button>
                    <Button Padding="6" Background="Transparent"
                            ToolTip.Tip="Open Folder"
                            Command="{Binding $parent[ItemsControl].((vm:BackupsViewModel)DataContext).OpenInExplorerCommand}"
                            CommandParameter="{Binding Path}">
                      <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                Width="14" Height="14"
                                Foreground="{DynamicResource Zinc300Brush}"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </Grid>
</UserControl>
