<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RiftLauncher.ViewModels.Pages"
             x:Class="RiftLauncher.Views.Pages.VersionsListView"
             x:DataType="vm:VersionsListViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Sticky Menu -->
        <Border Grid.Row="0" Background="#3309090b" Padding="8"
                BorderBrush="#0Da1a1aa" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                              Foreground="#a1a1aa" Width="16" Height="16"/>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="/" Foreground="#71717a" FontSize="12"/>
                    <TextBlock Text="VS Versions" Foreground="#e4e4e7" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
                <Button Grid.Column="2" Width="32" Height="32" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                              Foreground="#a1a1aa" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="8">
            <StackPanel Spacing="8" MaxWidth="800" HorizontalAlignment="Center" Margin="0,8">

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <!-- Install new version -->
                    <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                            CornerRadius="2" Padding="12,8" Cursor="Hand"
                            Command="{Binding NavigateToAddPageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M15,17H13V13H9V11H13V7H15V11H19V13H15V17Z"
                                      Foreground="#a1a1aa" Width="14" Height="14"/>
                            <TextBlock Text="Install new version" Foreground="#e4e4e7" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <!-- Search for existing -->
                    <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                            CornerRadius="2" Padding="12,8" Cursor="Hand"
                            Command="{Binding NavigateToLookupPageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Foreground="#a1a1aa" Width="14" Height="14"/>
                            <TextBlock Text="Search for existing" Foreground="#e4e4e7" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Version list -->
                <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameVersionDisplay">
                            <Border Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                    CornerRadius="2" Height="32" Margin="0,2" Padding="8,0">
                                <Grid ColumnDefinitions="*,1,Auto,Auto">
                                    <!-- Version name -->
                                    <TextBlock Grid.Column="0" Text="{Binding Version}"
                                               FontWeight="Bold" FontSize="12" Foreground="#e4e4e7"
                                               VerticalAlignment="Center"/>
                                    <!-- Separator -->
                                    <Border Grid.Column="1" Width="1" Background="#40a1a1aa" Margin="8,4"/>
                                    <!-- Open folder -->
                                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                            Width="28" Height="28" Padding="4" Cursor="Hand"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:VersionsListViewModel)DataContext).OpenFolderCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Open Folder">
                                        <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                                  Foreground="#a1a1aa" Width="12" Height="12"/>
                                    </Button>
                                    <!-- Delete -->
                                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                            Width="28" Height="28" Padding="4" Cursor="Hand"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:VersionsListViewModel)DataContext).RequestDeleteCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Uninstall">
                                        <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                  Foreground="#b91c1c" Width="12" Height="12"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Delete Confirmation Dialog -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#CC09090b"
                IsVisible="{Binding ShowDeleteDialog}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                ZIndex="100">
            <Border Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                    CornerRadius="4" Padding="24" MaxWidth="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="Uninstall Version" FontSize="20" FontWeight="Bold"
                               Foreground="#e4e4e7" HorizontalAlignment="Center"/>
                    <TextBlock Text="Are you sure you want to uninstall this version?"
                               Foreground="#e4e4e7" FontSize="13" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="This action cannot be undone."
                               Foreground="#a1a1aa" FontSize="11" HorizontalAlignment="Center"/>

                    <!-- In-use warning -->
                    <Border Background="#1Aea580" BorderBrush="#4Dea580" BorderThickness="1"
                            CornerRadius="4" Padding="12,8"
                            IsVisible="{Binding ShowInUseWarning}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                                      Foreground="#fdba74" Width="16" Height="16"/>
                            <TextBlock Text="{Binding InUseInstallations}" Foreground="#fdba74" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                CornerRadius="2" Padding="16,8" Cursor="Hand"
                                Command="{Binding CancelDeleteCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"
                                          Foreground="#65a30d" Width="14" Height="14"/>
                                <TextBlock Text="Cancel" Foreground="#65a30d" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                CornerRadius="2" Padding="16,8" Cursor="Hand"
                                Command="{Binding ConfirmDeleteCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                          Foreground="#b91c1c" Width="14" Height="14"/>
                                <TextBlock Text="Uninstall" Foreground="#b91c1c" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
