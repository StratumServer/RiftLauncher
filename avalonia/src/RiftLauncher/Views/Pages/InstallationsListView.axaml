<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RiftLauncher.ViewModels.Pages"
             x:Class="RiftLauncher.Views.Pages.InstallationsListView"
             x:DataType="vm:InstallationsListViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,16,24,8">
      <TextBlock Text="Installations"
                 FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource Zinc100Brush}"
                 VerticalAlignment="Center"/>
      <Button Grid.Column="1"
              Classes="accent"
              Padding="12,6"
              Command="{Binding $parent[UserControl].((vm:InstallationsListViewModel)DataContext).OpenFolderCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M15,17H9V15H15V17M15,13H13V7H11V13H9L12,16L15,13Z"
                    Width="14" Height="14"/>
          <TextBlock Text="Add New"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- List -->
    <ScrollViewer Grid.Row="1" Padding="24,0">
      <ItemsControl ItemsSource="{Binding Installations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:InstallationItemViewModel">
            <Border Margin="0,0,0,6"
                    Padding="8"
                    Background="{DynamicResource Zinc800Brush}"
                    CornerRadius="6"
                    Height="64">
              <Grid ColumnDefinitions="56,Auto,*,Auto,Auto">
                <!-- Icon -->
                <Border Width="48" Height="48"
                        CornerRadius="4"
                        Background="{DynamicResource Zinc700Brush}"
                        ClipToBounds="True">
                  <TextBlock Text="{Binding Name, Converter={x:Static vm:InstallationsListViewModel.InitialConverter}}"
                             FontSize="20" FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource VsLightBrush}"/>
                </Border>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Margin="8,4"
                        Background="{DynamicResource Zinc600Brush}"/>

                <!-- Name + metadata -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                  <TextBlock Text="{Binding Name}"
                             FontWeight="Bold" FontSize="13"
                             Foreground="{DynamicResource Zinc100Brush}"
                             TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <TextBlock Text="{Binding LastPlayedDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource Zinc400Brush}"/>
                    <TextBlock Text="·" FontSize="11"
                               Foreground="{DynamicResource Zinc400Brush}"/>
                    <TextBlock Text="{Binding TotalTimeDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource Zinc400Brush}"/>
                  </StackPanel>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="3" Width="1" Margin="8,4"
                        Background="{DynamicResource Zinc600Brush}"/>

                <!-- Version + Actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                  <!-- Version badge -->
                  <StackPanel VerticalAlignment="Center" Width="60">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                      <PathIcon Data="M1,21H23L12,2"
                                Width="10" Height="10"
                                Foreground="#fb923c"
                                IsVisible="{Binding IsVersionMissing}"/>
                      <TextBlock Text="{Binding Version}"
                                 FontWeight="Bold" FontSize="12"
                                 HorizontalAlignment="Center">
                        <TextBlock.Styles>
                          <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Zinc200Brush}"/>
                          </Style>
                        </TextBlock.Styles>
                      </TextBlock>
                    </StackPanel>
                    <TextBlock FontSize="10"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Zinc400Brush}">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} mods">
                          <Binding Path="ModsCount"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>

                  <!-- Action buttons 3x2 grid -->
                  <UniformGrid Columns="3" Rows="2" Width="78" Height="44">
                    <Button Padding="4" Background="Transparent" ToolTip.Tip="Backup"
                            Command="{Binding $parent[ItemsControl].((vm:InstallationsListViewModel)DataContext).MakeBackupCommand}"
                            CommandParameter="{Binding Id}">
                      <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Width="14" Height="14"
                                Foreground="{DynamicResource Zinc300Brush}"/>
                    </Button>
                    <Button Padding="4" Background="Transparent" ToolTip.Tip="Restore">
                      <PathIcon Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z" Width="14" Height="14"
                                Foreground="{DynamicResource Zinc300Brush}"/>
                    </Button>
                    <Button Padding="4" Background="Transparent" ToolTip.Tip="Mods">
                      <PathIcon Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L8.5,5.5L5.5,8.5L1.7,4.7C0.6,7.1 1.1,10.1 3.1,12.1C5,14 7.7,14.5 9.9,13.6L19,22.7C19.4,23.1 20,23.1 20.4,22.7L22.6,20.5C23.1,20.1 23.1,19.4 22.7,19Z" Width="14" Height="14"
                                Foreground="{DynamicResource Zinc300Brush}"/>
                    </Button>
                    <Button Padding="4" Background="Transparent" ToolTip.Tip="Open Folder"
                            Command="{Binding $parent[ItemsControl].((vm:InstallationsListViewModel)DataContext).OpenFolderCommand}"
                            CommandParameter="{Binding Path}">
                      <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Width="14" Height="14"
                                Foreground="{DynamicResource Zinc300Brush}"/>
                    </Button>
                    <Button Padding="4" Background="Transparent" ToolTip.Tip="Edit">
                      <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Width="14" Height="14"
                                Foreground="{DynamicResource Zinc300Brush}"/>
                    </Button>
                    <Button Padding="4" Background="Transparent" ToolTip.Tip="Delete"
                            Command="{Binding $parent[ItemsControl].((vm:InstallationsListViewModel)DataContext).RequestDeleteCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="14" Height="14"
                                Foreground="#dc2626"/>
                    </Button>
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
