<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RiftLauncher.ViewModels.Pages"
             x:Class="RiftLauncher.Views.Pages.InstallationsListView"
             x:DataType="vm:InstallationsListViewModel">
    <Border Padding="24">
        <TextBlock Text="Installations"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Zinc100Brush}" />
    </Border>
</UserControl>
