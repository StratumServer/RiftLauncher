<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RiftLauncher.ViewModels.Pages"
             x:Class="RiftLauncher.Views.Pages.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="*">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="16" MaxWidth="700">
            <!-- Title -->
            <TextBlock Text="{Binding WelcomeMessage}"
                       FontSize="32" FontWeight="Bold"
                       Foreground="#e4e4e7"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <!-- Description -->
            <TextBlock Text="A custom launcher for Vintage Story by the Stratum project."
                       FontSize="16" Foreground="#a1a1aa"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <!-- YouTube Trailer Thumbnail -->
            <Button Command="{Binding OpenTrailerCommand}"
                    Background="Transparent" BorderThickness="0"
                    Padding="0" Margin="24"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="Watch Trailer">
                <Border CornerRadius="6" ClipToBounds="True"
                        MaxWidth="560" MaxHeight="315">
                    <Panel>
                        <!-- Thumbnail placeholder (async load not supported in static AXAML) -->
                        <Border Background="#3f3f46"
                                Width="560" Height="315"/>
                        <!-- Dark overlay -->
                        <Border Background="#4D09090b">
                            <!-- Play icon centered -->
                            <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                      Foreground="#CCffffff"
                                      Width="56" Height="56"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </Panel>
                </Border>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
