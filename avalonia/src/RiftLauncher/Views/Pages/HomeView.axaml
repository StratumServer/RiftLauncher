<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RiftLauncher.ViewModels.Pages"
             x:Class="RiftLauncher.Views.Pages.HomeView"
             x:DataType="vm:HomeViewModel">
    <Border Padding="24">
        <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
            <TextBlock Text="Welcome to Rift Launcher"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#f4f4f5"
                       HorizontalAlignment="Center" />
            <Border Background="#27272a" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="0" FontSize="28" FontWeight="Bold"
                                       Foreground="#7e501e" HorizontalAlignment="Center" />
                            <TextBlock Text="Installations" FontSize="12"
                                       Foreground="#a1a1aa" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="0" FontSize="28" FontWeight="Bold"
                                       Foreground="#7e501e" HorizontalAlignment="Center" />
                            <TextBlock Text="Versions" FontSize="12"
                                       Foreground="#a1a1aa" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
