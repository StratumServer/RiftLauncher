<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiftLauncher.ViewModels"
        xmlns:controls="using:RiftLauncher.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RiftLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="600"
        Background="Transparent"
        Classes="Scale100">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Background image layer (full cover) -->
        <Image Source="/Assets/Images/background.jpg"
               Stretch="UniformToFill" />

        <!-- Overlay: 15% zinc-950 (matching Electron bg-zinc-950/15) -->
        <Border Background="{StaticResource OverlayBackground}" />

        <!-- Main layout: Sidebar (288px) + Content -->
        <Grid ColumnDefinitions="288,*">
            <!-- Sidebar: bg-zinc-950/30, backdrop-blur-sm, border-r zinc-400/5 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="8"
                    ZIndex="99">
                <DockPanel>
                    <!-- Bottom section: Play button + quick actions + installations dropdown -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                        <!-- Installations dropdown (h-56px) -->
                        <Border Background="{StaticResource ButtonBackground}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="56"
                                Padding="4,4,8,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Icon thumbnail -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="2" ClipToBounds="True">
                                    <Image Source="/Assets/Images/background.jpg" Stretch="UniformToFill"/>
                                </Border>
                                <!-- Installation name -->
                                <TextBlock Grid.Column="1" Text="{Binding CurrentInstallationName}"
                                           VerticalAlignment="Center" Margin="8,0"
                                           FontSize="14" Foreground="{StaticResource Zinc200Brush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Caret -->
                                <PathIcon Grid.Column="2" Data="M7,10L12,15L17,10H7Z"
                                          Foreground="{StaticResource Zinc400Brush}"
                                          Width="16" Height="16"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Play row: button + quick actions grid -->
                        <Grid ColumnDefinitions="*,56">
                            <!-- Play button (h-56px, bg-vs) -->
                            <Button Grid.Column="0"
                                    Classes="accent"
                                    Height="56"
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    FontSize="24">
                                <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                          Foreground="White" Width="24" Height="24"/>
                            </Button>

                            <!-- Quick action grid (2x2) -->
                            <UniformGrid Grid.Column="1" Rows="2" Columns="2">
                                <Button Classes="form-button" Padding="4"
                                        ToolTip.Tip="Download">
                                    <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                              Foreground="{StaticResource Zinc400Brush}" Width="14" Height="14"/>
                                </Button>
                                <Button Classes="form-button" Padding="4"
                                        ToolTip.Tip="Mods">
                                    <PathIcon Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L8.5,5.5L5.5,8.5L1.7,4.7C0.6,7.1 1,10.1 3,12.1C4.9,14 7.6,14.5 9.9,13.6L19,22.7C19.4,23.1 20,23.1 20.4,22.7L22.6,20.5C23.1,20.1 23.1,19.4 22.7,19Z"
                                              Foreground="{StaticResource Zinc400Brush}" Width="14" Height="14"/>
                                </Button>
                                <Button Classes="form-button" Padding="4"
                                        ToolTip.Tip="Edit">
                                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                              Foreground="{StaticResource Zinc400Brush}" Width="14" Height="14"/>
                                </Button>
                                <Button Classes="form-button" Padding="4"
                                        ToolTip.Tip="Add">
                                    <PathIcon Data="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                              Foreground="{StaticResource Zinc400Brush}" Width="14" Height="14"/>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>

                    <!-- Top row: Session button + Tasks -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,32" Height="32" Margin="0,0,0,8">
                        <!-- Session button -->
                        <Button Grid.Column="0" Classes="form-button"
                                Height="32" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="8,0">
                            <TextBlock Text="{Binding SessionDisplayName}"
                                       FontSize="12" Foreground="{StaticResource Zinc200Brush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Button>

                        <!-- Tasks button -->
                        <controls:TasksPopup Grid.Column="1"
                                             DataContext="{Binding Tasks}"
                                             Width="32" Height="32"/>
                    </Grid>

                    <!-- Navigation links (fills remaining space) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="nav-link"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding Index}"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="4,Auto,*">
                                            <!-- Active indicator (4px left border) -->
                                            <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                    Background="{Binding ActiveBrush}"
                                                    VerticalAlignment="Stretch"/>

                                            <!-- Icon -->
                                            <PathIcon Grid.Column="1" Data="{Binding IconData}"
                                                      Foreground="{StaticResource Zinc400Brush}"
                                                      Width="24" Height="24"
                                                      Margin="8,0,8,0"/>

                                            <!-- Text: Title + Description -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold" FontSize="14"
                                                           Foreground="{StaticResource Zinc200Brush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource Zinc400Brush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasDescription}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content area -->
            <Border Grid.Column="1">
                <TransitioningContentControl Content="{Binding CurrentPage}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.1" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Border>
        </Grid>
    </Panel>
</Window>
