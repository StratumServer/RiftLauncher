<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiftLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="RiftLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="600"
        Background="Transparent"
        Classes="Scale100">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Background image layer -->
        <Image Source="/Assets/Images/background.jpg"
               Stretch="UniformToFill"
               IsVisible="True" />

        <!-- Dark overlay with blur effect -->
        <Border Background="{StaticResource OverlayBackground}" />

        <!-- Main layout: Sidebar + Content -->
        <Grid ColumnDefinitions="72,*">
            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    Padding="0,8">
                <DockPanel>
                    <!-- Play button at bottom -->
                    <Button DockPanel.Dock="Bottom"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            Margin="8,8,8,12"
                            Height="40"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <PathGeometry>M8,5.14V19.14L19,12.14L8,5.14Z</PathGeometry>
                    </Button>

                    <!-- Navigation items -->
                    <ListBox SelectedIndex="{Binding SelectedNavIndex}"
                             Background="Transparent"
                             Margin="0,8,0,0">
                        <ListBoxItem Classes="nav-item" ToolTip.Tip="Home">
                            <PathGeometry>M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</PathGeometry>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item" ToolTip.Tip="Installations">
                            <PathGeometry>M4,6H20V16H4M4,4A2,2 0 0,0 2,6V16A2,2 0 0,0 4,18H8L10,20H14L16,18H20A2,2 0 0,0 22,16V6A2,2 0 0,0 20,4H4Z</PathGeometry>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item" ToolTip.Tip="VS Versions">
                            <PathGeometry>M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75Z</PathGeometry>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item" ToolTip.Tip="Mods">
                            <PathGeometry>M12,2L2,7L12,12L22,7L12,2M2,17L12,22L22,17L12,12L2,17Z</PathGeometry>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item" ToolTip.Tip="Config">
                            <PathGeometry>M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</PathGeometry>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item" ToolTip.Tip="Info &amp; Help">
                            <PathGeometry>M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</PathGeometry>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Content area -->
            <Border Grid.Column="1"
                    Background="{StaticResource ContentBackground}"
                    Margin="1,0,0,0">
                <TransitioningContentControl Content="{Binding CurrentPage}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.1" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Border>
        </Grid>
    </Panel>
</Window>
