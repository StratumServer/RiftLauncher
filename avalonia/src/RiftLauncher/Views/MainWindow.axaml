<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiftLauncher.ViewModels"
        x:Class="RiftLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="600"
        Background="#09090b"
        Classes="Scale100">

    <Panel>
        <!-- Background image -->
        <Image Source="/Assets/Images/background.jpg"
               Stretch="UniformToFill" />

        <!-- Dark overlay -->
        <Border Background="#2609090b" />

        <!-- Main layout: Sidebar w-72 (288px) + Content -->
        <Grid ColumnDefinitions="288,*">

            <!-- ==================== SIDEBAR ==================== -->
            <!-- bg-zinc-950/30, shadow-sm shadow-zinc-950/50, backdrop-blur-sm, border-r border-zinc-400/5 -->
            <Border Grid.Column="0"
                    Background="#4D09090b"
                    BorderBrush="#0Da1a1aa"
                    BorderThickness="0,0,1,0"
                    Padding="8">
                <DockPanel LastChildFill="True">

                    <!-- TOP ROW: SessionButton + TasksMenu (flex items-center shrink-0 gap-2) -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,0,0,16">
                        <!-- Session button: w-full h-8, FormButton style -->
                        <Button Background="#8009090b"
                                BorderBrush="#0Da1a1aa"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="32"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,0"
                                Cursor="Hand"
                                Command="{Binding Session.Login.OpenDialogCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                          Foreground="#a1a1aa" Width="14" Height="14"/>
                                <TextBlock Text="{Binding SessionDisplayName}"
                                           Foreground="#e4e4e7"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- Tasks menu: w-8 h-8 -->
                        <Button Width="32" Height="32"
                                Background="#8009090b"
                                BorderBrush="#0Da1a1aa"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                Command="{Binding Tasks.ToggleCommand}">
                            <PathIcon Data="M19 3H5C3.89 3 3 3.89 3 5V19A2 2 0 0 0 5 21H19A2 2 0 0 0 21 19V5C21 3.89 20.1 3 19 3M19 19H5V5H19V19M17 12H7V14H17V12M13 16H7V18H13V16M17 8H7V10H17V8Z"
                                      Foreground="#a1a1aa" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <!-- BOTTOM: InstallationsDropdown + Play + QuickActions -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8">

                        <!-- Installations dropdown: h-14 (56px) -->
                        <Button Background="#8009090b"
                                BorderBrush="#0Da1a1aa"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="56"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8"
                                Cursor="Hand">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentInstallationName}"
                                               Foreground="#e4e4e7"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CurrentInstallationDesc}"
                                               Foreground="#a1a1aa"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <PathIcon Grid.Column="1"
                                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                          Foreground="#a1a1aa" Width="14" Height="14"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Play + QuickActions row: flex gap-2 items-center -->
                        <Grid ColumnDefinitions="*,Auto" Height="56">
                            <!-- Play button: w-full h-14 bg-vs -->
                            <Button Grid.Column="0"
                                    Background="#7e501e"
                                    Foreground="White"
                                    CornerRadius="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand"
                                    IsEnabled="{Binding HasInstallationSelected}"
                                    Command="{Binding PlayCommand}">
                                <TextBlock Text="PLAY"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Button>

                            <!-- Quick actions: shrink-0 w-14 grid-cols-2 grid-rows-2 gap-1 -->
                            <UniformGrid Grid.Column="1" Columns="2" Rows="2"
                                         Width="56" Height="56"
                                         Margin="8,0,0,0"
                                         IsVisible="{Binding HasInstallationSelected}">
                                <!-- Backup -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Backup"
                                        Command="{Binding QuickBackupCommand}">
                                    <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                                <!-- Mods -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Manage Mods"
                                        Command="{Binding QuickModsCommand}">
                                    <PathIcon Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L8.5,5.5L5.5,8.5L1.7,4.7C0.6,7.1 1.1,10.1 3.1,12.1C5,14 7.7,14.5 9.9,13.6L19,22.7C19.4,23.1 20,23.1 20.4,22.7L22.6,20.5C23.1,20.1 23.1,19.4 22.7,19Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                                <!-- Edit -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Edit Installation"
                                        Command="{Binding QuickEditCommand}">
                                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                                <!-- Add -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Add Installation"
                                        Command="{Binding QuickAddCommand}">
                                    <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M15,17H13V13H9V11H13V7H15V11H19V13H15V17Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>

                    <!-- NAV LINKS: ItemsControl + Button.navitem (MVVM, like Prospect) -->
                    <ItemsControl ItemsSource="{Binding NavItems}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItemViewModel">
                                <Button Classes="navitem"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding SelectCommand}"
                                        Margin="0,2"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{Binding IconData}"
                                                  Foreground="#a1a1aa" Width="20" Height="20"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"
                                                       Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding HasDescription}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ==================== CONTENT AREA ==================== -->
            <Border Grid.Column="1">
                <Panel>
                    <TransitioningContentControl Content="{Binding CurrentPage}"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch">
                        <TransitioningContentControl.PageTransition>
                            <CrossFade Duration="0:0:0.1" />
                        </TransitioningContentControl.PageTransition>
                    </TransitioningContentControl>

                    <!-- Notifications: top-right overlay, w-80 (320px) -->
                    <ItemsControl ItemsSource="{Binding Notifications.Notifications}"
                                  Width="320"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="0,8,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NotificationItem">
                                <Border Margin="0,0,0,8"
                                        Padding="8"
                                        CornerRadius="2"
                                        Background="#9909090b"
                                        BorderThickness="4,0,0,0"
                                        BorderBrush="#7e501e">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <PathIcon Grid.Column="0"
                                                  Width="20" Height="20"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                                  Foreground="#ad7639"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   Foreground="#a1a1aa"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <Button Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Foreground="#a1a1aa" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Login Dialog overlay -->
                    <Border IsVisible="{Binding Session.Login.ShowDialog}"
                            Background="#CC09090b"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#8009090b"
                                BorderBrush="#0Da1a1aa"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="24"
                                Width="640">
                            <StackPanel Spacing="16" DataContext="{Binding Session.Login}">
                                <TextBlock Text="Log In"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#e4e4e7"
                                           HorizontalAlignment="Center"/>

                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Email"
                                                   Foreground="#e4e4e7" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right" Margin="0,0,12,0"/>
                                        <TextBox Grid.Column="1" Classes="form-input"
                                                 Text="{Binding Email}"
                                                 PlaceholderText="Email"
                                                 IsReadOnly="{Binding IsLoggingIn}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="Password"
                                                   Foreground="#e4e4e7" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right" Margin="0,0,12,0"/>
                                        <TextBox Grid.Column="1" Classes="form-input"
                                                 Text="{Binding Password}"
                                                 PlaceholderText="Password"
                                                 PasswordChar="&#x2022;"
                                                 IsReadOnly="{Binding IsLoggingIn}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="2FA Code"
                                                   Foreground="#e4e4e7" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBox Classes="form-input"
                                                     Text="{Binding TotpCode}"
                                                     PlaceholderText="2FA Code"
                                                     MaxLength="6"
                                                     IsReadOnly="{Binding IsLoggingIn}"/>
                                            <TextBlock Text="Only if you have 2FA enabled"
                                                       Foreground="#71717a" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" Spacing="16">
                                    <Button Classes="form-button error" Padding="12,8"
                                            Command="{Binding CloseDialogCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"
                                                      Foreground="#b91c1c" Width="14" Height="14"/>
                                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="form-button success" Padding="12,8"
                                            Command="{Binding LoginCommand}"
                                            IsEnabled="{Binding !IsLoggingIn}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                                      Foreground="#65a30d" Width="14" Height="14"/>
                                            <TextBlock Text="Log In" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Panel>
            </Border>
        </Grid>
    </Panel>
</Window>
