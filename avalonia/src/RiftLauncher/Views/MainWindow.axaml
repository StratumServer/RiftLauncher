<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiftLauncher.ViewModels"
        x:Class="RiftLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="720"
        MinWidth="1024" MinHeight="600"
        Background="#09090b"
        Classes="Scale100">

    <Panel>
        <!-- Background image -->
        <Image Source="/Assets/Images/background.jpg"
               Stretch="UniformToFill" />

        <!-- Dark overlay -->
        <Border Background="#2609090b" />

        <!-- Main layout: Sidebar w-72 (288px) + Content -->
        <Grid ColumnDefinitions="288,*">

            <!-- ==================== SIDEBAR ==================== -->
            <!-- bg-zinc-950/30, shadow-sm shadow-zinc-950/50, backdrop-blur-sm, border-r border-zinc-400/5 -->
            <Border Grid.Column="0"
                    Background="#4D09090b"
                    BorderBrush="#0Da1a1aa"
                    BorderThickness="0,0,1,0"
                    Padding="8">
                <DockPanel LastChildFill="True">

                    <!-- TOP ROW: SessionButton + TasksMenu (flex items-center shrink-0 gap-2) -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,0,0,16">
                        <!-- Session button: w-full h-8, FormButton style -->
                        <Button Background="#8009090b"
                                BorderBrush="#0Da1a1aa"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="32"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,0"
                                Cursor="Hand"
                                Command="{Binding Session.Login.OpenDialogCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                          Foreground="#a1a1aa" Width="14" Height="14"/>
                                <TextBlock Text="{Binding SessionDisplayName}"
                                           Foreground="#e4e4e7"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <!-- Tasks menu: w-8 h-8 -->
                        <Button Width="32" Height="32"
                                Background="#8009090b"
                                BorderBrush="#0Da1a1aa"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                Command="{Binding Tasks.ToggleCommand}">
                            <PathIcon Data="M19 3H5C3.89 3 3 3.89 3 5V19A2 2 0 0 0 5 21H19A2 2 0 0 0 21 19V5C21 3.89 20.1 3 19 3M19 19H5V5H19V19M17 12H7V14H17V12M13 16H7V18H13V16M17 8H7V10H17V8Z"
                                      Foreground="#a1a1aa" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <!-- BOTTOM: InstallationsDropdown + Play + QuickActions -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8">

                        <!-- Installations dropdown: h-14 (56px) -->
                        <Button Background="#8009090b"
                                BorderBrush="#0Da1a1aa"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="56"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8"
                                Cursor="Hand">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentInstallationName}"
                                               Foreground="#e4e4e7"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CurrentInstallationDesc}"
                                               Foreground="#a1a1aa"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <PathIcon Grid.Column="1"
                                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                          Foreground="#a1a1aa" Width="14" Height="14"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Play + QuickActions row: flex gap-2 items-center -->
                        <Grid ColumnDefinitions="*,Auto" Height="56">
                            <!-- Play button: w-full h-14 bg-vs -->
                            <Button Grid.Column="0"
                                    Background="#7e501e"
                                    Foreground="White"
                                    CornerRadius="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand"
                                    IsEnabled="{Binding HasInstallationSelected}"
                                    Command="{Binding PlayCommand}">
                                <TextBlock Text="PLAY"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Button>

                            <!-- Quick actions: shrink-0 w-14 grid-cols-2 grid-rows-2 gap-1 -->
                            <UniformGrid Grid.Column="1" Columns="2" Rows="2"
                                         Width="56" Height="56"
                                         Margin="8,0,0,0"
                                         IsVisible="{Binding HasInstallationSelected}">
                                <!-- Backup -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Backup"
                                        Command="{Binding QuickBackupCommand}">
                                    <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                                <!-- Mods -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Manage Mods"
                                        Command="{Binding QuickModsCommand}">
                                    <PathIcon Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L8.5,5.5L5.5,8.5L1.7,4.7C0.6,7.1 1.1,10.1 3.1,12.1C5,14 7.7,14.5 9.9,13.6L19,22.7C19.4,23.1 20,23.1 20.4,22.7L22.6,20.5C23.1,20.1 23.1,19.4 22.7,19Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                                <!-- Edit -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Edit Installation"
                                        Command="{Binding QuickEditCommand}">
                                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                                <!-- Add -->
                                <Button Background="#8009090b" BorderBrush="#0Da1a1aa" BorderThickness="1"
                                        CornerRadius="2" Padding="2"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Cursor="Hand" ToolTip.Tip="Add Installation"
                                        Command="{Binding QuickAddCommand}">
                                    <PathIcon Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M15,17H13V13H9V11H13V7H15V11H19V13H15V17Z"
                                              Foreground="#a1a1aa" Width="12" Height="12"/>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>

                    <!-- NAV LINKS: h-full flex flex-col gap-2 -->
                    <ListBox SelectedIndex="{Binding SelectedNavIndex}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,0,0,8"
                             Padding="0">
                        <ListBox.Styles>
                            <!-- Nav item: border-l-4, px-2 py-1, rounded-sm, hover:pl-3, duration-100 -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="CornerRadius" Value="2"/>
                                <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="#15ffffff"/>
                                <Setter Property="Padding" Value="12,6,8,6"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="BorderBrush" Value="#7e501e"/>
                                <Setter Property="Background" Value="#267e501e"/>
                            </Style>
                        </ListBox.Styles>

                        <!-- Home -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z"
                                          Foreground="#a1a1aa" Width="20" Height="20"/>
                                <StackPanel>
                                    <TextBlock Text="Home" FontWeight="Bold" FontSize="12"
                                               Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Main page" FontSize="10"
                                               Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Installations -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                          Foreground="#a1a1aa" Width="20" Height="20"/>
                                <StackPanel>
                                    <TextBlock Text="Installations" FontWeight="Bold" FontSize="12"
                                               Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Manage game installations" FontSize="10"
                                               Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- VS Versions -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M2.6,10.59L8.38,4.8L10.07,6.5C9.83,7.35 10.22,8.28 11,8.73V14.27C10.4,14.61 10,15.26 10,16A2,2 0 0,0 12,18A2,2 0 0,0 14,16C14,15.26 13.6,14.61 13,14.27V9.41L15.07,11.5C15,11.65 15,11.82 15,12A2,2 0 0,0 17,14A2,2 0 0,0 19,12A2,2 0 0,0 17,10C16.82,10 16.65,10 16.5,10.07L13.93,7.5C14.19,6.57 13.71,5.55 12.78,5.16C12.35,4.97 11.89,4.94 11.47,5.06L9.8,3.38L10.59,2.6C11.37,1.81 12.63,1.81 13.41,2.6L21.4,10.59C22.19,11.37 22.19,12.63 21.4,13.41L13.41,21.4C12.63,22.19 11.37,22.19 10.59,21.4L2.6,13.41C1.81,12.63 1.81,11.37 2.6,10.59Z"
                                          Foreground="#a1a1aa" Width="20" Height="20"/>
                                <StackPanel>
                                    <TextBlock Text="VS Versions" FontWeight="Bold" FontSize="12"
                                               Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Manage game versions" FontSize="10"
                                               Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Mods -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L8.5,5.5L5.5,8.5L1.7,4.7C0.6,7.1 1.1,10.1 3.1,12.1C5,14 7.7,14.5 9.9,13.6L19,22.7C19.4,23.1 20,23.1 20.4,22.7L22.6,20.5C23.1,20.1 23.1,19.4 22.7,19Z"
                                          Foreground="#a1a1aa" Width="20" Height="20"/>
                                <StackPanel>
                                    <TextBlock Text="Mods" FontWeight="Bold" FontSize="12"
                                               Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Browse and manage mods" FontSize="10"
                                               Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Config -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                          Foreground="#a1a1aa" Width="20" Height="20"/>
                                <StackPanel>
                                    <TextBlock Text="Config" FontWeight="Bold" FontSize="12"
                                               Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Launcher settings" FontSize="10"
                                               Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Info & Help -->
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                          Foreground="#a1a1aa" Width="20" Height="20"/>
                                <StackPanel>
                                    <TextBlock Text="Info &amp; Help" FontWeight="Bold" FontSize="12"
                                               Foreground="#e4e4e7" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="About and support" FontSize="10"
                                               Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ==================== CONTENT AREA ==================== -->
            <Border Grid.Column="1">
                <TransitioningContentControl Content="{Binding CurrentPage}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.1" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Border>
        </Grid>
    </Panel>
</Window>
